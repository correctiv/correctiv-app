# Dependencies
node_modules/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# General
.DS_Store
.AppleDouble
.LSOverride
.idea
.cloud
.project
tmp/
typings/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Screenshot tours write their PNGs here before they are converted into screens/
# (see screens/README.md). The WebP versions are committed, the PNGs are not.
out/

# Agent worktrees (Claude Code) — checkouts, not content.
.claude/worktrees/

# Browser-automation scratch output. The bare *.png rule is because the driver
# writes its screenshots to the working directory when given a relative name, and
# one of them reached a commit that way.
.playwright-mcp/
/*.png

# Agent skills are local tooling, installed per developer. They were once swept
# into a commit by an `add -A`; the symlink under .claude/skills points into
# .agents, so both have to stay out.
.agents/
.claude/skills/
skills-lock.json

# The assembled Pages artifact: the workbench's build with the app's export copied
# under /app. Built in CI, and locally when checking the deploy shape.
site/

# Staged by apps/desktop/scripts/stage-fonts.mjs from @expo-google-fonts.
apps/desktop/data/fonts/

# gjsify ship output.
apps/desktop/ship/
