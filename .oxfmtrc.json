{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "semi": true,
  "tabWidth": 2,
  "printWidth": 100,
  "trailingComma": "all",
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "bracketSpacing": true,
  "arrowParens": "always",
  "vueIndentScriptAndStyle": false,
  "ignorePatterns": [
    "media/**",
    ".github/**",
    "**/*.md",
    "**/*.scss",
    "packages/app-core/test/__fixtures__/**",
    "apps/mobile/__fixtures__/**",
    "apps/mobile/assets/**",
    "**/*.d.mts",
    "package-lock.json",
    "**/*.generated.*",
    // Written by `uniwind generate-artifacts` and by the Uniwind bundler plugins,
    // which have their own formatting and would undo ours on the next run. Two
    // packages have one now: the app, and the workbench, which draws the app's
    // components and so needs the same `className` declarations.
    "**/uniwind-types.d.ts",
    // Generated by packages/design-tokens; they do not match `*.generated.*`
    // because their names are the import paths a consumer writes.
    "packages/design-tokens/theme.css",
    "packages/design-tokens/theme.standalone.css",
    // Written by kit.mjs, sync-tokens.mjs and use-kit.mjs, all three of which emit
    // `JSON.stringify(spec, null, 2)`. oxfmt puts short arrays on one line, so the
    // two disagree permanently and every generator run would otherwise break
    // `npm run check` until somebody remembered to reformat.
    "tools/figma-plugin/spec.json",
    // Vendored design tokens — must stay byte-identical to upstream so a plain diff
    // against a fresh checkout is meaningful, and because theme.css is embedded
    // verbatim into the reader WebView. See tokens/README.md.
    "tokens/**"
  ],
  "sortPackageJson": false
}
