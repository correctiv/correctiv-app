{
  "name": "@correctiv/catalogue",
  "description": "Every user-facing string the app ships, by locale: the German that reaches a reader and the English the descriptors were written in. Data only — no UI framework, no platform SDK, no React.",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "devDependencies": {
    "@correctiv/app-core": "*",
    "@correctiv/prose-and-code": "*",
    "@formatjs/cli": "^6.16.28",
    "@formatjs/icu-messageformat-parser": "^3.5.18",
    "intl-messageformat": "^11.2.15"
  },
  "scripts": {
    "compile": "node scripts/compile.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  }
}
