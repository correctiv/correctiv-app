{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "verbatimModuleSyntax": true,
    // The Vite config and its plugins are loaded as source, so their imports
    // carry the extension Vite's native config loader wants. Allowed because
    // the base config sets noEmit.
    "allowImportingTsExtensions": true,
    "paths": {
      // Test-only, and only the subpath form: the preview's seed test holds its
      // copies of the app's storage layout against the originals. The core ships
      // TypeScript rather than a build and its exports map has no extensions, so
      // tsc cannot follow the subpaths without this. Vite and vitest resolve them
      // through the workspace symlink either way, and nothing under `src/` imports
      // the core, so the bundle is unchanged.
      "@correctiv/app-core/*": ["../../packages/app-core/src/*"],
      // The app's own alias, so this package can name a component of the app the
      // way the app names it. `vite.app.mjs` is the resolver's half of the same
      // agreement, and `src/components/direct.tsx` is currently the only caller.
      "@/*": ["../mobile/src/*"]
    }
  },
  // `uniwind-types.d.ts` is generated by the Uniwind plugin on every build and
  // committed, as it is in `apps/mobile`, because a fresh clone typechecks before
  // it builds. It is what gives `<View className="…">` a `className` at all.
  "include": [
    "src",
    "content",
    "test",
    "uniwind-types.d.ts",
    "vite.app.mjs",
    "vite.config.ts",
    "plugin",
    // The two TypeScript scripts, by name: `scripts/` is otherwise JavaScript that
    // `allowJs` would pull in unasked. What .github/workflows/submission.yml runs.
    "scripts/submission.ts",
    "scripts/submission-from-issue.ts"
  ]
}
