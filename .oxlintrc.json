{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // NOTE: this file is JSONC — comments are supported and are the only place
  // rule decisions are recorded. Do not silence a rule without saying why.
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "vue",
    "react",
    "jsx-a11y",
    "import",
    "promise",
    "jest"
  ],
  // react-perf is deliberately NOT enabled. Its jsx-no-new-{object,function,array}-as-prop
  // rules flagged 37 sites in apps/mobile, all of them inline props that the
  // React Compiler memoizes automatically — the app turns it on via
  // app.json "experiments": { "reactCompiler": true }. Enabling the plugin would
  // mean hand-memoizing what the compiler already does, i.e. fighting the toolchain.
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "es2022": true,
    "browser": true
  },
  "globals": {
    "__ANDROID__": "readonly",
    "__IOS__": "readonly",
    "__VISIONOS__": "readonly",
    "__DEV__": "readonly",
    "java": "readonly",
    "android": "readonly",
    "androidx": "readonly",
    "NSObject": "readonly",
    "UIApplication": "readonly",
    // `figma` is the Plugin API object, injected by Figma into a plugin's sandbox.
    // Only tools/figma-plugin sees it, and it can never be imported: there is no
    // module to import it from.
    "figma": "readonly"
  },
  "ignorePatterns": [
    "media/**",
    "packages/app-core/test/__fixtures__/**",
    "apps/mobile/__fixtures__/**"
  ],
  "rules": {
    "no-console": "off",

    "no-underscore-dangle": "off",

    // Suggests the ES2023 toSorted(). The core is meant to run on any runtime,
    // including ones without it, so the in-place sort stays.
    "unicorn/no-array-sort": "off",

    "oxc/no-map-spread": "warn",

    // Obsolete since React 17's automatic JSX runtime: JSX no longer expands to
    // React.createElement, so React need not be in scope. apps/mobile is on
    // React 19 and babel-preset-expo's automatic runtime. Left on, this produced
    // 132 false positives in one pass.
    "react/react-in-jsx-scope": "off",

    // Assumes `style` is always a style object. expo-status-bar's StatusBar takes
    // a StatusBarStyle string union ("dark" | "light" | "auto"), so <StatusBar
    // style="dark" /> is correct and the rule cannot tell the difference.
    "react/style-prop-object": "off"
  },
  "overrides": [
    {
      "files": ["**/*.d.ts"],
      "rules": {
        "typescript/triple-slash-reference": "off"
      }
    },
    {
      // The generator scripts fetch upstream resources one at a time on purpose —
      // sequential requests are gentler on correctiv.org than a burst.
      "files": ["apps/mobile/scripts/**"],
      "rules": {
        "no-await-in-loop": "off"
      }
    },
    {
      // Side-effect-only imports are how Expo Router and the styling engine are
      // wired up: `import 'expo-router/entry'` registers the root component,
      // `import '@/global.css'` is the CSS entry Uniwind's Metro transform reads.
      // There is nothing to assign.
      //
      // The last two are the same thing for `Intl`: a polyfill's whole job is the
      // global it installs, and the `require` spelling is what makes it
      // conditional — the file says why it must be.
      "files": [
        "apps/mobile/index.js",
        "apps/mobile/src/app/_layout.tsx",
        "apps/mobile/src/i18n/Localisation.tsx",
        "apps/mobile/src/i18n/polyfills.ts"
      ],
      "rules": {
        "import/no-unassigned-import": "off"
      }
    },
    {
      // `allow-scripts` + `allow-same-origin` is the combination the rule warns
      // about, because for a SAME-ORIGIN frame it lets the document remove its own
      // sandbox. This frame is cross-origin (youtube-nocookie.com), so
      // `allow-same-origin` keeps YouTube's origin — not ours — and there is
      // nothing to escape into. Dropping it instead breaks the player: it needs
      // storage access to initialise. What the sandbox still buys us is the part
      // that matters here — the embed cannot navigate the top-level page.
      "files": ["apps/mobile/src/components/media/VideoFrame.web.tsx"],
      "rules": {
        "react/iframe-missing-sandbox": "off"
      }
    },
    {
      // A command palette is an ARIA combobox over a listbox, and that is the
      // pattern these rules are steering away from. `prefer-tag-over-role`
      // suggests `select`, which cannot render a two-line row, cannot be filtered
      // as you type and cannot be opened from a keyboard shortcut over the whole
      // page. `no-noninteractive-element-to-interactive-role` is asking for the
      // same substitution. The roles here are the accessible spelling of the
      // widget, not a shortcut around one: the input owns the listbox, options
      // carry ids and `aria-selected`, and `aria-activedescendant` follows the
      // arrow keys. Autofocus is what a palette is for, and the dialog was opened
      // by an explicit gesture. The options themselves take no key listener on
      // purpose: in this pattern they are never focused, the input keeps focus
      // and the arrows move `aria-activedescendant`, so a per-option handler
      // would be unreachable code that only satisfies a rule.
      "files": ["apps/workbench/src/ui/Search.tsx"],
      "rules": {
        "jsx-a11y/click-events-have-key-events": "off",
        "jsx-a11y/prefer-tag-over-role": "off",
        "jsx-a11y/no-noninteractive-element-to-interactive-role": "off",
        "jsx-a11y/no-autofocus": "off"
      }
    },
    {
      // A diagram wider than the column scrolls inside its own box, and a
      // keyboard user needs a focus stop to reach that scroll. The rule is right
      // in general, wrong here: `tabIndex={0}` on a scroll container is the
      // documented way to make it reachable, and it is the reason the container
      // is not merely decorative. Chrome and Firefox now focus scroll containers
      // on their own, Safari does not, and a diagram nobody can scroll is worse
      // than a lint exception with a reason attached. Every figure is a component
      // in `src/diagrams/` now, and takes its scroll box with it, so that is the
      // one place this markup sits.
      "files": ["apps/workbench/src/diagrams/*.tsx"],
      "rules": {
        "jsx-a11y/no-noninteractive-tabindex": "off"
      }
    },
    {
      // The frame's page list, and the same argument as the palette above, which
      // is the interaction this repeats one bar down: the dialog is opened by an
      // explicit click and exists for nothing but typing a page name, so focusing
      // the field is what the click asked for. Only this one rule, because unlike
      // the palette this list needs no role of its own — `cmdk` owns the options.
      "files": ["apps/workbench/src/preview/ui/Pages.tsx"],
      "rules": {
        "jsx-a11y/no-autofocus": "off"
      }
    },
    {
      // The search screen exists for nothing but searching, and it is only ever
      // reached by an explicit tap on the search entry — so focusing the field is
      // what the user just asked for, and it saves a second tap plus a keyboard
      // animation. jsx-a11y's concern (focus stolen on page load, context lost)
      // applies to web forms that happen to contain an input, not to a pushed
      // search route. The field carries an accessibilityLabel.
      "files": ["apps/mobile/src/app/suche.tsx"],
      "rules": {
        "jsx-a11y/no-autofocus": "off"
      }
    }
  ]
}
